{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROAM editable operating rules",
  "description": "Project-defined rules, separate from STRIDE robot observations. Additional semantic checks are enforced by policy.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "routing",
    "execution",
    "vendor"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRoutingEnabled",
        "rules"
      ],
      "properties": {
        "localRoutingEnabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "enabled",
              "priority",
              "conditions",
              "route"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact",
                    "operator",
                    "value"
                  ],
                  "properties": {
                    "fact": {
                      "enum": [
                        "staffed",
                        "operatorsOnShift",
                        "availableOperators",
                        "schoolFaultsToday",
                        "robotType",
                        "progressPercent",
                        "deadlineMissed",
                        "cause",
                        "exceptionType"
                      ]
                    },
                    "operator": {
                      "enum": [
                        "==",
                        "!=",
                        "<",
                        "<=",
                        ">",
                        ">="
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              "route": {
                "enum": [
                  "local",
                  "hq"
                ]
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireStaffForToilet",
        "requireVacancyForFloor",
        "requireFloorPreflight",
        "outsideWindowRecovery",
        "liftEscalationMinutes",
        "faultAssessmentProgressPercent"
      ],
      "properties": {
        "requireStaffForToilet": {
          "type": "boolean"
        },
        "requireVacancyForFloor": {
          "type": "boolean"
        },
        "requireFloorPreflight": {
          "type": "boolean"
        },
        "outsideWindowRecovery": {
          "enum": [
            "manual_fallback",
            "wait_for_overlap"
          ]
        },
        "liftEscalationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "faultAssessmentProgressPercent": {
          "type": "number",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shiftStart",
        "shiftEnd",
        "parallelTickets"
      ],
      "properties": {
        "shiftStart": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "shiftEnd": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "parallelTickets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
