{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future school-agent recommendation proposal",
  "description": "Interface design only; not yet called by the live browser. Proposals are not executable robot commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schoolId",
    "basedOnMinute",
    "taskId",
    "recommendation",
    "summary",
    "evidence",
    "needsHumanReview"
  ],
  "properties": {
    "schoolId": {
      "type": "string",
      "pattern": "^SCH-[0-9]{3}$"
    },
    "basedOnMinute": {
      "type": "integer",
      "minimum": 0
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommendation": {
      "enum": [
        "monitor",
        "route_to_school_supervisor",
        "request_vendor_support",
        "propose_manual_fallback",
        "request_service_plan_review"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "observedValue"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "observedValue": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "needsHumanReview": {
      "type": "boolean"
    }
  }
}
